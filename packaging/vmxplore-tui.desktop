# vmx — the terminal console's launcher: vmx running in vmxplore's terminal.
#
# Read by the desktop's app grid and dock. Without it, vmx has no icon and is
# only reachable from a shell.
#
# Exec: `vmxplore --term vmx` opens a window holding vmxplore's terminal (the
# same widget as the GUI's terminal pane) with vmx inside it, and closes it
# when vmx exits. On a host with no GUI build, run `vmx` in any terminal.
#
# StartupWMClass=vmx matches that window's fixed title "vmx", which is what
# the desktop pairs with this entry (see gui_term.go), so the running window
# groups under this icon and not under the GUI's.
[Desktop Entry]
Type=Application
Name=vmx
GenericName=VM Console (terminal)
Comment=The ZFS-aware VM and estate console, in the terminal
Exec=vmxplore --term vmx
Icon=vmx
Terminal=false
StartupWMClass=vmx
Categories=System;Monitor;Emulator;
Keywords=vm;kvm;libvirt;virsh;zfs;zvol;snapshot;estate;console;tui;terminal;
